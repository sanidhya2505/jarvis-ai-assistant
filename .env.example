# Copy this file to .env and fill in your own values.
# NEVER commit the real .env file.

# --- General ---
APP_NAME=JARVIS
USER_NAME=Sanidhya
ENVIRONMENT=development

# --- Database ---
DATABASE_URL=sqlite:///./data/database/jarvis.db

# --- AI / LLM provider ---
# One of: openai | anthropic | local
# "local" disables AI-generated answers entirely (tasks/calendar/file
# search still work; embeddings fall back to a local model automatically).
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

# --- Web search (kept OFF by default: files are the source of truth) ---
ENABLE_WEB_SEARCH=false

# --- Voice ---
ENABLE_VOICE=false
WAKE_WORD=hey jarvis
TTS_PROVIDER=pyttsx3
STT_PROVIDER=whisper_local

# --- Startup / tray ---
START_WITH_WINDOWS=true
MINIMIZE_TO_TRAY_ON_CLOSE=true

# --- Notifications ---
DEFAULT_REMINDER_MINUTES_BEFORE=15

# --- Local API server (used internally by the desktop UI) ---
API_HOST=127.0.0.1
API_PORT=8765
